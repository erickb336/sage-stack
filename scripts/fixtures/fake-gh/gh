#!/usr/bin/env node
import fs from "node:fs";
const args = process.argv.slice(2), call = args.slice(0, 2).join(" ");
const answers = process.env.SAGE_TEST_GH ? JSON.parse(fs.readFileSync(process.env.SAGE_TEST_GH, "utf8")) : {};
const say = (value) => process.stdout.write(JSON.stringify(value));
const paths = (list) => (list ?? []).map((path) => ({ path }));
if (answers.fail === call) {
  process.stderr.write(`fake gh: ${call} failed\n`);
  process.exit(1);
} else if (call === "pr view" && args.includes("files,baseRefName")) say({ files: paths(answers.files ?? ["a.txt"]), baseRefName: answers.base ?? "main" });
else if (args[0] === "api" && /^repos\/\{owner\}\/\{repo\}\/commits\/[0-9a-f]{40}$/.test(args[1] ?? "")) say({ date: answers.dates?.[args[1].slice(-40)] ?? "2000-01-01T00:00:00Z" });
else if (call === "pr list" && args.includes("number,mergedAt,files")) say((answers.merged ?? []).map((m) => ({ ...m, files: paths(m.files) })));
else {
  process.stderr.write(`fake gh: no answer for gh ${args.join(" ")}\n`);
  process.exit(1);
}
